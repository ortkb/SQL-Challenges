-- Challenge 1



-- Output 1
SELECT
SPLIT_PART(TRANSACTION_CODE, '-', 1) AS Bank,
SUM(VALUE)
FROM PD2023_WK01,
-- Transaction Date to Weekdate
 GROUP BY Bank
;

-- Output 2
SELECT 
SPLIT_PART(TRANSACTION_CODE, '-', 1) AS Bank, -- Get Bank
DAYNAME(TO_DATE(TRANSACTION_DATE, 'DD/MM/YYYY HH:MI:SS')) AS Weekday,
SUM(VALUE),
CASE 
    WHEN ONLINE_OR_IN_PERSON = '1' THEN 'Online'
    WHEN ONLINE_OR_IN_PERSON = '2' THEN 'In-Person' 
END as Online_or_InPerson
FROM PD2023_WK01,
-- Transaction Date to Weekdate
 GROUP BY Bank, Weekday, Online_or_InPerson
;

-- Output 3
SELECT
SPLIT_PART(TRANSACTION_CODE, '-', 1) AS Bank,
SUM(VALUE),
CUSTOMER_CODE
FROM PD2023_WK01,
-- Transaction Date to Weekdate
 GROUP BY Bank, CUSTOMER_CODE
;

-- Challenge 2

SELECT 
TRANSACTION_ID,
CONCAT(
'GB', 
CHECK_DIGITS, 
SWIFT_CODE,
REPLACE(SORT_CODE, '-', ''), 
ACCOUNT_NUMBER
)
FROM PD2023_WK02_TRANSACTIONS
LEFT JOIN PD2023_WK02_SWIFT_CODES
ON PD2023_WK02_SWIFT_CODES.BANK = PD2023_WK02_TRANSACTIONS.BANK
;


-- Challenge 3
WITH _TARGETS AS 
(
    SELECT
    ONLINE_OR_IN_PERSON AS TARGETS_ONL_INPER,
    TARGETS,
    RIGHT(QUARTERS, 1) AS QUARTERS,
    FROM PD2023_WK03_TARGETS
    UNPIVOT( TARGETS FOR QUARTERS IN (Q1, Q2, Q3, Q4))
)

//SELECT * FROM _TARGETS;

SELECT
SPLIT_PART(TRANSACTION_CODE, '-', 1) AS Bank,
CASE 
    WHEN ONLINE_OR_IN_PERSON = '1' THEN 'Online'
    WHEN ONLINE_OR_IN_PERSON = '2' THEN 'In-Person' 
END as _Online_or_InPerson,
QUARTER(
    TO_DATE(TRANSACTION_DATE, 'DD/MM/YYYY HH:MI:SS')
) AS _QUART,
SUM(Value),
TARGETS,
SUM(VALUE) - TARGETS AS DIFFERENCE
FROM PD2023_WK01

INNER JOIN _TARGETS 
ON _QUART = QUARTERS 
AND
_Online_or_InPerson = TARGETS_ONL_INPER

GROUP BY Bank, _Online_or_InPerson, _QUART, TARGETS
HAVING Bank = 'DSB'

;



-- Challenge 4

WITH ALLSALES_CTE AS
(
    SELECT 'PD2023_WK04_APRIL' AS TABLENAME, * FROM PD2023_WK04_APRIL
    UNION ALL
    SELECT 'PD2023_WK04_AUGUST' AS TABLENAME, * FROM PD2023_WK04_AUGUST
    UNION ALL
    SELECT 'PD2023_WK04_DECEMBER' AS TABLENAME, * FROM PD2023_WK04_DECEMBER
    UNION ALL
    SELECT 'PD2023_WK04_FEBRUARY' AS TABLENAME, * FROM PD2023_WK04_FEBRUARY
    UNION ALL
    SELECT 'PD2023_WK04_JANUARY' AS TABLENAME, * FROM PD2023_WK04_JANUARY
    UNION ALL
    SELECT 'PD2023_WK04_JULY' AS TABLENAME, * FROM PD2023_WK04_JULY
    UNION ALL
    SELECT 'PD2023_WK04_JUNE' AS TABLENAME, * FROM PD2023_WK04_JUNE
    UNION ALL
    SELECT 'PD2023_WK04_MARCH' AS TABLENAME, * FROM PD2023_WK04_MARCH
    UNION ALL
    SELECT 'PD2023_WK04_MAY' AS TABLENAME, * FROM PD2023_WK04_MAY
    UNION ALL
    SELECT 'PD2023_WK04_NOVEMBER' AS TABLENAME, * FROM PD2023_WK04_NOVEMBER
    UNION ALL
    SELECT 'PD2023_WK04_OCTOBER' AS TABLENAME, * FROM PD2023_WK04_OCTOBER
    UNION ALL
    SELECT 'PD2023_WK04_SEPTEMBER' AS TABLENAME, * FROM PD2023_WK04_SEPTEMBER
),

PIVOTED_CTE AS
(
    SELECT  
    ID,
    ACCOUNT_TYPE,
    DATE_OF_BIRTH :: DATE as DATE_OF_BIRTH, -- Type Cast
    ETHNICITY,
    SPLIT_PART(TABLENAME, '_', 3) AS SALESMONTH,
    DATE_FROM_PARTS(
        2023, 
        DATE_PART(
            'month', 
            DATE(
                SALESMONTH, 'MMMM'
            )
        ), JOINING_DAY
    ) AS JOINING_DATE,
    ROW_NUMBER() OVER(PARTITION BY ID ORDER BY JOINING_DATE ASC) AS ORDER_BY_JOIN_DATE
    FROM ALLSALES_CTE
    PIVOT(
        MIN(VALUE) FOR DEMOGRAPHIC IN 
        ('Ethnicity' AS ETHNICITY, 'Account Type' AS ACCOUNT_TYPE, 'Date of Birth' AS DATE_OF_BIRTH)
    )
)

SELECT
ID,
JOINING_DATE,
ACCOUNT_TYPE,
DATE_OF_BIRTH,
ETHNICITY
FROM PIVOTED_CTE
WHERE ORDER_BY_JOIN_DATE = 1
;
